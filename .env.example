# --- Telegram ---
BOT_TOKEN=put-your-token-here
# Публичный URL Mini App (пусто = кнопка Mini App не показывается)
MINIAPP_URL=

# --- Служебный API для внешней заливки скриншотов ---
INGEST_API_KEY=сгенерируйте-свой-ключ
API_HOST=0.0.0.0
API_PORT=8080

# --- Хранилище (синхронный SQLAlchemy; для Postgres: postgresql+psycopg://...) ---
DATABASE_URL=sqlite:///./data/runtime/honest.db

# --- Загрузки с шортката iPhone (POST /upload, GET /files) ---
# Каталог рядом с базой, в своём именованном томе docker: файлы обязаны
# пережить передеплой. Относительный путь считается от корня проекта.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
# Внешний адрес для поля "url" в ответе. Пусто — ссылка соберётся из адреса
# запроса, а за туннелем это даст нерабочий http://.
PUBLIC_BASE_URL=https://look-own-alt-electronics.trycloudflare.com
# Пусто — приём файлов открыт (так задумано в ТЗ шортката). Непустое
# значение требует заголовок X-API-Key на POST /upload и GET /files.
UPLOAD_API_KEY=

# --- LLM: polza | openrouter | local | none (OpenAI-совместимый) ---
LLM_PROVIDER=polza
LLM_BASE_URL=https://api.polza.ai/api/v1
LLM_API_KEY=
LLM_TIMEOUT_S=60
LLM_MODEL_FAST=google/gemini-3.5-flash-lite
LLM_MODEL_VISION=google/gemini-3.5-flash-lite
LLM_MODEL_SMART=anthropic/claude-sonnet-5
LLM_VISION_FALLBACKS=qwen/qwen3-vl-30b-a3b-instruct,anthropic/claude-haiku-4.5

# --- Распознавание речи: remote | local | none ---
ASR_PROVIDER=none
ASR_MODEL=ai-sage/gigaam-v3
ASR_FALLBACKS=openai/whisper-large-v3-turbo,openai/whisper-large-v3
ASR_API_KEY=

# --- Поведение ---
TZ=Europe/Moscow
DIGEST_HOUR=21
WEEKLY_SUMMARY_WEEKDAY=6
SHARED_BILL_DEADLINE_DAYS=30
DEBT_MATCH_WINDOW_DAYS=90
REFUND_MATCH_WINDOW_DAYS=60
CASH_UNALLOCATED_AFTER_DAYS=14
