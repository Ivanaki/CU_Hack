# Что не попадает в контекст сборки: контекст меньше — сборка быстрее,
# и случайный файл не сбрасывает кэш слоёв.
# Внимание: шаблоны здесь не рекурсивные, вложенные каталоги ловит только **/.
.venv/
venv/
**/__pycache__/
**/*.pyc
.git/
.gitignore

# Рабочая база живёт в томе на сервере. Локальную копию тащить нельзя —
# при COPY она перезапишет содержимое образа своей устаревшей версией.
data/runtime/
**/*.db
**/*.sqlite3

# То же про файлы с шортката: они живут в томе на сервере.
data/uploads/
data/uploads-local/

**/.pytest_cache/
**/.ruff_cache/
tests/
miniapp/concepts/

# Секреты в слои образа не запекаем: контейнер берёт их из env_file.
.env

# В рантайме не нужны
deploy/
desktop/
dashboard/
*.md
.vscode/
.idea/
